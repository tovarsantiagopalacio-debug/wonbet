# Servidor
PORT=4001
NODE_ENV=development

# Base de datos PostgreSQL (Servicio de Usuarios)
DATABASE_URL="postgresql://wonbet:wonbet123@localhost:5432/usuarios?schema=public"

# JWT
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=2h

# Bcrypt
BCRYPT_ROUNDS=10

# Clave interna para endpoints usados por otros microservicios (apuestas-service)
INTERNAL_API_KEY=cambia-esta-clave-interna

# URLs de otros servicios (para salir a buscar datos si es necesario)
EVENTOS_URL=http://localhost:4002
APUESTAS_URL=http://localhost:4003
NOTIFICACIONES_URL=http://localhost:4004